# Salin menjadi app_core/.env di server, lalu isi nilai bertanda ISI.
# Jangan commit file .env yang sudah terisi.
APP_NAME=EMS
APP_ENV=production
# ISI: jalankan di komputer sendiri `php artisan key:generate --show`, tempel hasilnya
APP_KEY=
APP_DEBUG=false
# ISI: alamat situs Anda, berawalan https
APP_URL=https://ISI-NAMA-SITUS.example
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=single
LOG_LEVEL=warning

# ISI dari panel InfinityFree > MySQL Databases (host BUKAN localhost)
DB_CONNECTION=mysql
DB_HOST=ISI-sqlXXX.infinityfree.com
DB_PORT=3306
DB_DATABASE=ISI
DB_USERNAME=ISI
DB_PASSWORD=ISI

# Tanpa tabel sesi/cache/antrean di database
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

FILESYSTEM_DISK=local
EBOOK_DISK=local

# Hosting ini menonaktifkan procedure, trigger, dan foreign key
EBOOK_SQL_OBJECTS=false
# Batas file 10 MB per file di InfinityFree; 9216 KB = 9 MB memberi sisa
EBOOK_MAX_UPLOAD_KB=9216
